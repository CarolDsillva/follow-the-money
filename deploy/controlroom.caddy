followthemoney.137-220-32-178.sslip.io {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
	}
	handle /api/* {
		reverse_proxy 127.0.0.1:8100 {
			flush_interval -1
		}
	}
	handle {
		root * /srv/controlroom/frontend
		@page not path /assets/*
		header @page Cache-Control "no-cache"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}


# The old address keeps working: it sends people to the new one.
controlroom.137-220-32-178.sslip.io {
	redir https://followthemoney.137-220-32-178.sslip.io{uri} permanent
}
